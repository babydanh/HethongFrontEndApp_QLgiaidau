API_BASE_URL=https://sporto.asia/api/v1
APP_API_KEY=replace_with_release_secret

# Sentry mobile telemetry is supplied at build time with --dart-define.
# Never put the real DSN in Git or ship a Sentry auth token in the app.
# SENTRY_DSN=https://public@example.ingest.sentry.io/123
# APP_ENV=staging
# APP_RELEASE=app@1.0.0+build
# SENTRY_TRACES_SAMPLE_RATE=0.1

FIREBASE_API_KEY_WEB=your_web_api_key
FIREBASE_APP_ID_WEB=your_web_app_id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_AUTH_DOMAIN=your_auth_domain
FIREBASE_STORAGE_BUCKET=your_storage_bucket

FIREBASE_API_KEY_ANDROID=your_android_api_key
FIREBASE_APP_ID_ANDROID=your_android_app_id

FIREBASE_API_KEY_IOS=your_ios_api_key
FIREBASE_APP_ID_IOS=your_ios_app_id
FIREBASE_IOS_CLIENT_ID=your_ios_client_id
FIREBASE_IOS_BUNDLE_ID=your_ios_bundle_id
